<Window x:Class="MiSwitcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gif="http://wpfanimatedgif.codeplex.com"
        Title="米家三合一切换器" Height="730" Width="1150"
        MinHeight="640" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="Transparent" FontFamily="Microsoft YaHei UI">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border CornerRadius="8" Background="#FF0E1016" BorderBrush="#2EFFFFFF" BorderThickness="1"
            ClipToBounds="True">
        <Grid>
            <!-- ============ 全窗口皮肤背景层（侧边栏/标题栏之下） ============ -->
            <Grid x:Name="BgLayer" Background="#FF10131B" />
            <Image x:Name="SkinImage" Stretch="UniformToFill" />
            <Rectangle Fill="{StaticResource ScrimBrush}" />

            <!-- ============ 内容层 ============ -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="216" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ================= 侧边栏（半透明，透出皮肤） ================= -->
                <Border Grid.Column="0" Background="{StaticResource SidebarBg}">
                    <Border.BorderBrush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#00FFFFFF" Offset="0" />
                            <GradientStop Color="#26FFFFFF" Offset="1" />
                        </LinearGradientBrush>
                    </Border.BorderBrush>
                    <Border BorderThickness="0,0,1,0">
                        <DockPanel LastChildFill="True">
                            <StackPanel DockPanel.Dock="Top" Margin="20,26,16,8">
                                <StackPanel Orientation="Horizontal">
                                    <!-- 应用图标：米哈游启动器 -->
                                    <Image Source="pack://application:,,,/Assets/app.ico" Width="34" Height="34"
                                           RenderOptions.BitmapScalingMode="HighQuality">
                                        <Image.Effect>
                                            <DropShadowEffect ShadowDepth="1" BlurRadius="6" Opacity="0.5" />
                                        </Image.Effect>
                                    </Image>
                                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="米家三合一切换器" FontSize="14" FontWeight="Bold"
                                                   Foreground="{StaticResource TextPrimary}"
                                                   Effect="{StaticResource TextShadow}" />
                                        <TextBlock Text="原神 · 星穹铁道 · 绝区零" FontSize="10.5"
                                                   Foreground="#FFC9D0DE" Margin="0,2,0,0"
                                                   Effect="{StaticResource TextShadow}" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel x:Name="GameList" DockPanel.Dock="Top" Margin="12,10,12,0" />

                            <StackPanel DockPanel.Dock="Bottom" Margin="12,0,12,16">
                                <Button x:Name="BtnSkin" Style="{StaticResource GlassButton}" HorizontalAlignment="Stretch"
                                        Margin="0,0,0,8" Click="BtnSkin_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource GlyphText}" Text="&#xE771;" FontSize="14" VerticalAlignment="Center" />
                                        <TextBlock Text="  切换器皮肤" FontSize="12.5" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnSettings" Style="{StaticResource GlassButton}" HorizontalAlignment="Stretch"
                                        Margin="0,0,0,8" Click="BtnSettings_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource GlyphText}" Text="&#xE713;" FontSize="14" VerticalAlignment="Center" />
                                        <TextBlock Text="  游戏路径设置" FontSize="12.5" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnPersistent" Style="{StaticResource GlassButton}" HorizontalAlignment="Stretch"
                                        Click="BtnPersistent_Click" ToolTip="在当前服进入游戏并完成热更后，把 Persistent 热更内容采集进资源替换包">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource GlyphText}" Text="&#xE8C8;" FontSize="14" VerticalAlignment="Center" />
                                        <TextBlock Text="  采集 Persistent" FontSize="12.5" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <TextBlock x:Name="FooterText" Text="v1.0.0" FontSize="10"
                                           Foreground="#66FFFFFF" Margin="6,12,0,0" />
                            </StackPanel>

                            <Grid />
                        </DockPanel>
                    </Border>
                </Border>

                <!-- ================= 主区域 ================= -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="44" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 标题栏（透明，直接透出皮肤） -->
                    <Grid Grid.Row="0" Background="Transparent">
                        <TextBlock x:Name="TitleHint" Text="" FontSize="11.5" Foreground="#CCFFFFFF"
                                   VerticalAlignment="Center" Margin="16,4,0,0"
                                   Effect="{StaticResource TextShadow}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    WindowChrome.IsHitTestVisibleInChrome="True">
                            <Button Style="{StaticResource IconButton}" Click="BtnMin_Click" ToolTip="最小化">
                                <TextBlock Style="{StaticResource GlyphText}" Text="&#xE921;" FontSize="11" />
                            </Button>
                            <Button Style="{StaticResource IconButton}" Click="BtnClose_Click" ToolTip="关闭">
                                <TextBlock Style="{StaticResource GlyphText}" Text="&#xE8BB;" FontSize="11" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- 内容 -->
                    <Grid Grid.Row="1" Margin="34,10,34,24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- 标题与状态 -->
                        <StackPanel Grid.Row="0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="GameTitle" Text="原神" FontSize="30" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimary}"
                                           Effect="{StaticResource TextShadow}" />
                                <TextBlock x:Name="GameSubtitle" Text="Genshin Impact" FontSize="13"
                                           Foreground="#FFC9D0DE" VerticalAlignment="Bottom" Margin="12,0,0,7"
                                           Effect="{StaticResource TextShadow}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="2,10,0,0">
                                <Border x:Name="ChipCurrent" CornerRadius="6" Padding="10,4" Background="#33E8B45A">
                                    <TextBlock x:Name="ChipCurrentText" Text="当前：检测中" FontSize="12" Foreground="#FFE8B45A" />
                                </Border>
                                <Border CornerRadius="6" Padding="10,4" Background="{StaticResource CardBg}" Margin="8,0,0,0"
                                        BorderBrush="{StaticResource Stroke}" BorderThickness="1">
                                    <TextBlock x:Name="ChipGameVersion" Text="游戏版本 -" FontSize="12" Foreground="{StaticResource TextDim}" />
                                </Border>
                                <Border CornerRadius="6" Padding="10,4" Background="{StaticResource CardBg}" Margin="8,0,0,0"
                                        BorderBrush="{StaticResource Stroke}" BorderThickness="1">
                                    <TextBlock x:Name="ChipPackVersion" Text="替换包 -" FontSize="12" Foreground="{StaticResource TextDim}" />
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <!-- 服务器选择 -->
                        <StackPanel Grid.Row="1" Margin="0,26,0,0">
                            <TextBlock Text="选择要切换的服务器" FontSize="13" Foreground="{StaticResource TextPrimary}" Margin="2,0,0,10" Effect="{StaticResource TextShadow}" />
                            <UniformGrid x:Name="ServerCards" Columns="3" />
                        </StackPanel>

                        <!-- 操作区 -->
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="2,24,0,0">
                            <Button x:Name="BtnSwitch" Click="BtnSwitch_Click" Cursor="Hand" IsEnabled="False"
                                    Content="一键切换" FontSize="15" FontWeight="Bold" Foreground="#FF161208"
                                    Padding="30,13">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" CornerRadius="12" Padding="{TemplateBinding Padding}"
                                                Background="{TemplateBinding Background}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                              TextBlock.FontSize="{TemplateBinding FontSize}"
                                                              TextBlock.FontWeight="{TemplateBinding FontWeight}"
                                                              TextBlock.Foreground="{TemplateBinding Foreground}" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Opacity" Value="0.9" />
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="bd" Property="Opacity" Value="0.75" />
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="bd" Property="Opacity" Value="0.35" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button x:Name="BtnLaunch" Style="{StaticResource GlassButton}" Margin="14,0,0,0"
                                    FontSize="13.5" Click="BtnLaunch_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource GlyphText}" Text="&#xE768;" FontSize="14" VerticalAlignment="Center" />
                                    <TextBlock Text="  启动游戏" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnOpenDir" Style="{StaticResource GlassButton}" Margin="10,0,0,0"
                                    FontSize="13.5" Click="BtnOpenDir_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource GlyphText}" Text="&#xE8B7;" FontSize="14" VerticalAlignment="Center" />
                                    <TextBlock Text="  打开游戏目录" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnRefresh" Style="{StaticResource GlassButton}" Margin="10,0,0,0"
                                    FontSize="13.5" Click="BtnRefresh_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource GlyphText}" Text="&#xE72C;" FontSize="14" VerticalAlignment="Center" />
                                    <TextBlock Text="  重新检测" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- 进度与日志 -->
                        <StackPanel Grid.Row="3" Margin="2,22,0,0">
                            <ProgressBar x:Name="Progress" Style="{StaticResource SlimProgress}" Minimum="0" Maximum="100"
                                         Value="0" Visibility="Collapsed" x:FieldModifier="public" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock x:Name="StageText" Text="" FontSize="12" Foreground="{StaticResource TextPrimary}" Effect="{StaticResource TextShadow}" />
                                <Button x:Name="BtnLog" Style="{StaticResource IconButton}" Width="70" Height="22"
                                        HorizontalAlignment="Left" Margin="16,0,0,0" Click="BtnLog_Click" Visibility="Collapsed">
                                    <TextBlock Text="查看日志" FontSize="11" Foreground="{StaticResource TextDim}" />
                                </Button>
                            </StackPanel>
                        </StackPanel>

                        <Border Grid.Row="4" x:Name="LogPanel" CornerRadius="10" Background="#E614161E"
                                BorderBrush="{StaticResource Stroke}" BorderThickness="1" Margin="2,14,0,0"
                                Visibility="Collapsed">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="10,8">
                                <TextBlock x:Name="LogText" FontFamily="Consolas" FontSize="11.5"
                                           Foreground="#FFB9C2D4" LineHeight="17" TextWrapping="Wrap" />
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>

            <!-- 弹层容器（皮肤 / 设置 / 确认框） -->
            <Grid x:Name="Overlay" Visibility="Collapsed">
                <Rectangle Fill="#99000000" MouseDown="OverlayBg_MouseDown" />
                <Border x:Name="PopupHost" Width="660" MinHeight="180" MaxHeight="640" CornerRadius="16"
                        Background="#FF171A23" BorderBrush="#33FFFFFF" BorderThickness="1"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
